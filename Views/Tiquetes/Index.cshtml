@* Views/Tiquetes/Index.cshtml *@
@model IEnumerable<TiqueteModel>

@{
    ViewData["Title"] = "Tickets";
}

<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Lista de Tickets</h5>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Nuevo Ticket
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Asunto</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ti_identificador</td>
                            <td>@item.ti_asunto</td>
                            <td>
                                <span class="badge bg-@(item.ti_estado == "Abierto" ? "success" :
                                                    item.ti_estado == "En Proceso" ? "warning" :
                                                    item.ti_estado == "Cerrado" ? "danger" : "secondary")">
                                    @item.ti_estado
                                </span>
                            </td>
                            <td>@item.ti_fecha_adicion.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.ti_identificador" class="btn btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ti_identificador" class="btn btn-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ti_identificador" class="btn btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>